# VideoScribe -- personal settings
#
# Copy this file to ".env" and change whatever you need. Values here override
# config.json, and are never committed to version control.
#
#     Windows : copy .env.example .env
#     Mac/Linux: cp .env.example .env
#
# Delete or comment out any line you do not need; the default is used instead.


# ---------------------------------------------------------------------------
# Interface language
# ---------------------------------------------------------------------------

# Language of the menus and messages: en or es.
# Leave empty to follow your operating system.
# Option 4 in the menu changes this and writes it back here for you.
VIDEOSCRIBE_UI_LANGUAGE=


# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------

# tiny | base | small | medium | large-v3
# Bigger is more accurate and slower. See: python videoscribe.py models
VIDEOSCRIBE_MODEL=small

# Language of the speech: es, en, fr, pt ... or "auto" to detect it.
VIDEOSCRIBE_LANGUAGE=es

# 0 = use every processor core, up to 16.
VIDEOSCRIBE_CPU_THREADS=0


# ---------------------------------------------------------------------------
# Speakers
# ---------------------------------------------------------------------------

# How many people speak. 0 asks the program to work it out.
# If the result splits one person in two, put the real number here and re-run
# with --resume; that takes seconds and does not repeat the transcription.
VIDEOSCRIBE_SPEAKERS=0

# The word placed before the number: Person1, Person2 ...
# Leave empty to follow the interface language (Speaker / Persona).
VIDEOSCRIBE_SPEAKER_LABEL=


# ---------------------------------------------------------------------------
# Written account of what is on screen (optional)
# ---------------------------------------------------------------------------

# true | false
VIDEOSCRIBE_NARRATION=true

# The language the account is written in, spelled out: Spanish, English ...
VIDEOSCRIBE_NARRATION_LANGUAGE=Spanish

# One video frame every N seconds. Lower catches more, costs more.
VIDEOSCRIBE_FRAME_INTERVAL=10

# How many seconds of video are described per request.
VIDEOSCRIBE_WINDOW_SECONDS=120


# ---------------------------------------------------------------------------
# Which image model describes the video
# ---------------------------------------------------------------------------
# Only one of these is needed, and only for the visual description. The
# transcript never needs any of them.
#
# Option 1, no API key: install the Claude Code command line tool and sign in
#   once. https://claude.com/claude-code  -- nothing to set here.
#
# Option 2, an API key from any of these providers. Uncomment one line.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...


# ---------------------------------------------------------------------------
# Folders and programs
# ---------------------------------------------------------------------------

# Where you drop videos, and where results are written.
# Relative paths are relative to this repository folder.
VIDEOSCRIBE_INBOX=inbox
VIDEOSCRIBE_OUTPUT=output

# Only needed if ffmpeg is installed somewhere unusual.
# Windows example:  C:\ffmpeg\bin\ffmpeg.exe
# VIDEOSCRIBE_FFMPEG=


# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------

# Keep the temporary WAV and the extracted frames after a run.
# Useful while experimenting, wasteful otherwise.
VIDEOSCRIBE_KEEP_WAV=false
VIDEOSCRIBE_KEEP_FRAMES=false
